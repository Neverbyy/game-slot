{
  "name": "game-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Slot game frontend (Vue 3 + Pinia + PixiJS)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "sim": "tsx scripts/simulate.ts",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "pixi.js": "^8.21.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.8",
    "sass-embedded": "^1.104.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
