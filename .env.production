VITE_USE_MOCK_API=true
# Адрес бэкенда без /api (пути уже начинаются с /api/...). Пусто — тот же домен.
VITE_API_URL=
VITE_DEBUG=false
# Виджет проверки экранов выигрыша (BIG / MEGA / SUPER / EPIC) — нужен и на проде.
VITE_DEBUG_PANEL=true
# Боевые частоты с выверенным RTP; ?tuning= и другие отладочные параметры
# URL на проде выключены (VITE_DEBUG=false).
VITE_TUNING=balanced
